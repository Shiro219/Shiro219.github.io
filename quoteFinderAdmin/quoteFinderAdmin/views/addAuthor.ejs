<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("partials/head.ejs") %>
    <title>Adding New Author</title>
</head>
<body>
    
    <h1>Adding New Author</h1>

    <form action="/addAuthor" method="POST">
        First Name: <input type="text" name="firstName"> <br>
        Last Name: <input type="text" name="lastName"> <br>
        Date of Birth: <input type="date" name="dob"> <br>
        Date of Death: <input type="date" name="dod"> <br>
        Sex:
        <input type="radio" id="male" value="M" name="sex"> <label for="male">Male</label>
        <input type="radio" id="female" value="F" name="sex"> <label for="female">Female</label> <br>
        Profession: <input type="text" name="profession"> <br>
        Country: <input type="text" name="country"> <br>
        Portrait URL: <textarea name="portrait"></textarea> <br>
        Biography: <textarea name="biography"></textarea> <br>
        <button>Add Author</button>
    </form>

    <footer>
        <%- include("partials/footer.ejs") %>
    </footer>

</body>
</html>